{
  "manifest_version": 3,
  "name": "SeatKoi Railway Connector",
  "version": "1.2.0",
  "description": "Transfers your existing Railway session credentials to SeatKoi when the token page opens.",
  "permissions": ["tabs"],
  "host_permissions": [
    "https://eticket.railway.gov.bd/*",
    "https://seatkoi.vercel.app/*"
  ],
  "background": {
    "service_worker": "dist/background/service-worker.js"
  },
  "content_scripts": [
    {
      "matches": ["https://eticket.railway.gov.bd/*"],
      "js": ["dist/content/railway-content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://seatkoi.vercel.app/token*"],
      "js": ["dist/content/seatkoi-bridge.js"],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_popup": "src/popup/popup.html",
    "default_title": "SeatKoi Railway Connector"
  },
  "icons": {
    "16": "public/icons/icon16.png",
    "48": "public/icons/icon48.png",
    "128": "public/icons/icon128.png"
  }
}
